# Application
APP_NAME="Internal Requests Manager"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Origin of the Next.js app
FRONTEND_URL=http://localhost:3000

# Locale (messages in Brazilian Portuguese, ADR 0001)
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

# Maintenance mode state storage
APP_MAINTENANCE_DRIVER=file

# Password hashing cost
BCRYPT_ROUNDS=12

# Logs
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database (MySQL service from docker-compose.yml)
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=internal_requests
DB_USERNAME=irm
DB_PASSWORD=secret
# PHPUnit uses the `testing` database (created by docker/mysql/init.sql)

# Session, cache and queue (all stored in the database)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
CACHE_STORE=database
QUEUE_CONNECTION=database

# Broadcasting and file storage
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Mail (Mailpit service: web interface at http://localhost:8025)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@internal-requests.test"
MAIL_FROM_NAME="${APP_NAME}"
