# Application
APP_NAME="Internal Requests Manager"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Origin of the Next.js app
FRONTEND_URL=http://localhost:3000

# Locale (messages in Brazilian Portuguese, ADR 0001)
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

# Maintenance mode state storage
APP_MAINTENANCE_DRIVER=file

# Password hashing cost
BCRYPT_ROUNDS=12

# Logs
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database (MySQL service from docker-compose.yml)
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=internal_requests
DB_USERNAME=irm
DB_PASSWORD=secret
# PHPUnit uses the `testing` database (created by docker/mysql/init.sql)

# Session, cache and queue (all stored in the database)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_EXPIRE_ON_CLOSE=true
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Stable cookie name: the front-end proxy checks it to know if there is a session
SESSION_COOKIE=irm_session
# Hosts that receive the Sanctum SPA session cookie
SANCTUM_STATEFUL_DOMAINS=localhost:3000

# Login (ADR 0004): "remember me" lasts 30 days (minutes);
# 5 wrong attempts per e-mail + IP block the login for 15 minutes
AUTH_REMEMBER_MINUTES=43200
LOGIN_MAX_ATTEMPTS=5
LOGIN_DECAY_MINUTES=15

# Invitation links stay valid for 7 days
INVITATION_EXPIRE_DAYS=7

CACHE_STORE=database
QUEUE_CONNECTION=database

# Broadcasting and file storage
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Mail (Mailpit service: web interface at http://localhost:8025)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@internal-requests.test"
MAIL_FROM_NAME="Gestão de Solicitações"

# Gmail (instead of Mailpit): requires 2-step verification and an app password (a secret).
# MAIL_FROM_ADDRESS must equal the account, since Gmail rewrites a different sender.
# Restart api and worker after changing these.
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your-account@gmail.com
# MAIL_PASSWORD=your-app-password

# Discord webhook for team notifications. It is a secret: never commit a real value.
# Empty disables the Discord channel (no job is queued).
DISCORD_WEBHOOK_URL=

# Local seed only: with an address here, the seed users become <local>+solicitante@<domain>,
# +analista and +admin, so assume/decide e-mails reach whoever is testing. Empty keeps @empresa.com.
# After changing it, run `php artisan migrate:fresh --seed`, or the seed adds the users again.
SEED_USERS_EMAIL=
